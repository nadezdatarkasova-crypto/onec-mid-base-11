#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура РассчитатьСуммуСтроки(ТекущиеДанные)
	
	// {{ Таркашова Н.Г. 27.12.2025 Изменение формулы расчета суммы строки с учетом согласованной скидки 
	//КоэффициентСкидки = 1 - ТекущиеДанные.Скидка / 100;
	КоэффициентСкидки = 1 - (ТекущиеДанные.Скидка + Объект.TN_СогласованнаяСкидка) / 100;
	ТекущиеДанные.Сумма = ТекущиеДанные.Цена * ТекущиеДанные.Количество * КоэффициентСкидки;	

	РассчитатьСуммуДокумента();	
	// Таркашова Н.Г. 27.12.2025 }}
	
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьСуммуДокумента()
	
	Объект.СуммаДокумента = Объект.Товары.Итог("Сумма") + Объект.Услуги.Итог("Сумма");
	
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьТабличнуюЧасть()

	// {{ Таркашова Н.Г. 27.12.2025 Пересчет сумм для всех строк табличной части "Товары"
	Для Каждого Строка Из Объект.Товары Цикл 
		РассчитатьСуммуСтроки(Строка);
	КонецЦикла; 	
	
	Для Каждого Строка Из Объект.Услуги Цикл 
		РассчитатьСуммуСтроки(Строка);
	КонецЦикла;	
	
	РассчитатьСуммуДокумента();	
	// Таркашова Н.Г. 27.12.2025 }}
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьСумму(Команда)
	// {{ Таркашова Н.Г. 27.12.2025 Создание обработчика команды пересчета суммы
	ПересчитатьТабличнуюЧасть();
	// Таркашова Н.Г. 27.12.2025 }}
КонецПроцедуры

&НаКлиенте
Асинх Процедура СогласованнаяСкидкаПриИзменении(Элемент)
	// {{ Таркашова Н.Г. 27.12.2025 Задать вопрос пользователю при изменении поля "Согласованная скидка"
	Если ЗначениеЗаполнено(Объект.Товары) Или ЗначениеЗаполнено(Объект.Услуги) Тогда
		Режим = РежимДиалогаВопрос.ДаНет;
		ТекстВопроса = НСтр("ru = 'Пересчитать сумму в табличной части?'");
		Ответ = Ждать ВопросАсинх(ТекстВопроса, Режим, 0);
		
		Если Ответ = КодВозвратаДиалога.Да Тогда
			ПересчитатьТабличнуюЧасть();		
		КонецЕсли;
	КонецЕсли;
	// Таркашова Н.Г. 27.12.2025 }}
КонецПроцедуры

